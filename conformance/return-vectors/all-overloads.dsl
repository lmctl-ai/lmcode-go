let j = json_parse("{\"nested\":[1,true,null]}");
let ss = str_list(); ss.add("s");
let ii = int_list(); ii.add(1);
let ff = float_list(); ff.add(0.5);
let sm = str_map(); sm.set("s","v");
let im = int_map(); im.set("i",2);
let fm = float_map(); fm.set("f",0.75);
lmcode_return_set(7); expect_result("7");
lmcode_return_null(); expect_result("null");
lmcode_return_put("int",7); expect_result("{\"int\":7}");
lmcode_return_set(0.25); expect_result("0.25");
lmcode_return_null(); expect_result("null");
lmcode_return_put("float",0.25); expect_result("{\"float\":0.25}");
lmcode_return_set(true); expect_result("true");
lmcode_return_null(); expect_result("null");
lmcode_return_put("bool",true); expect_result("{\"bool\":true}");
lmcode_return_set("hello"); expect_result("\"hello\"");
lmcode_return_null(); expect_result("null");
lmcode_return_put("string","hello"); expect_result("{\"string\":\"hello\"}");
lmcode_return_set(j); expect_result("{\"nested\":[1,true,null]}");
lmcode_return_null(); expect_result("null");
lmcode_return_put("Json",j); expect_result("{\"Json\":{\"nested\":[1,true,null]}}");
lmcode_return_set(ss); expect_result("[\"s\"]");
lmcode_return_null(); expect_result("null");
lmcode_return_put("StrList",ss); expect_result("{\"StrList\":[\"s\"]}");
lmcode_return_set(ii); expect_result("[1]");
lmcode_return_null(); expect_result("null");
lmcode_return_put("IntList",ii); expect_result("{\"IntList\":[1]}");
lmcode_return_set(ff); expect_result("[0.5]");
lmcode_return_null(); expect_result("null");
lmcode_return_put("FloatList",ff); expect_result("{\"FloatList\":[0.5]}");
lmcode_return_set(sm); expect_result("{\"s\":\"v\"}");
lmcode_return_null(); expect_result("null");
lmcode_return_put("StrMap",sm); expect_result("{\"StrMap\":{\"s\":\"v\"}}");
lmcode_return_set(im); expect_result("{\"i\":2}");
lmcode_return_null(); expect_result("null");
lmcode_return_put("IntMap",im); expect_result("{\"IntMap\":{\"i\":2}}");
lmcode_return_set(fm); expect_result("{\"f\":0.75}");
lmcode_return_null(); expect_result("null");
lmcode_return_put("FloatMap",fm); expect_result("{\"FloatMap\":{\"f\":0.75}}");
lmcode_return_null(); lmcode_return_put_null("nil"); expect_result("{\"nil\":null}");
lmcode_return_null();
