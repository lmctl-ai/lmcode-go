let m=str_map().set("a","one").set("b","two").set("c","three"); let keys=m.keys(); let values=m.values(); m.set("a","NEW"); m.remove("b"); m.set("b","NEW"); t.hex(m.keys().join(",")); t.hex(values.at(0)); t.hex(values.at(1)); keys.set(0,"changed"); values.set(0,"two"); keys.add("extra"); values.add("one"); t.hex(m.keys().join(",")); t.hex(m.get("a")); m.clear(); t.int(keys.len()); t.int(values.len());
