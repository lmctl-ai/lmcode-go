{
 "version": 2,
 "options": {
  "max_body_bytes": 1024
 },
 "stream": [
  {
   "name": "health json",
   "method": "GET",
   "target": "/health",
   "expect": {
    "status": 200,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"status\":\"ok\"}"
   }
  },
  {
   "name": "path param",
   "method": "GET",
   "target": "/hello/world",
   "expect": {
    "status": 200,
    "headers": {
     "content-type": "text/plain; charset=utf-8"
    },
    "body": "hello, world"
   }
  },
  {
   "name": "percent-decoded param",
   "method": "GET",
   "target": "/hello/w%C3%B6rld",
   "expect": {
    "status": 200,
    "body": "hello, wörld"
   }
  },
  {
   "name": "query overrides default",
   "method": "GET",
   "target": "/hello/bob?greeting=hi%20there",
   "expect": {
    "status": 200,
    "body": "hi there, bob"
   }
  },
  {
   "name": "plus is a space in queries",
   "method": "GET",
   "target": "/hello/bob?greeting=a+b",
   "expect": {
    "status": 200,
    "body": "a b, bob"
   }
  },
  {
   "name": "encoded slash stays in one segment",
   "method": "GET",
   "target": "/hello/a%2Fb",
   "expect": {
    "status": 200,
    "body": "hello, a/b"
   }
  },
  {
   "name": "invalid percent escape is 400",
   "method": "GET",
   "target": "/hello/%zz",
   "expect": {
    "status": 400,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"error\":\"bad request\"}"
   }
  },
  {
   "name": "integer query params",
   "method": "GET",
   "target": "/add?a=2&b=40",
   "expect": {
    "status": 200,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"sum\":42}"
   }
  },
  {
   "name": "handler-chosen 400",
   "method": "GET",
   "target": "/add?a=2&b=x",
   "expect": {
    "status": 400,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"error\":\"a and b must be integers\"}"
   }
  },
  {
   "name": "json body in, status out",
   "method": "POST",
   "target": "/sum",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"values\":[1,2,3]}",
   "expect": {
    "status": 201,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"sum\":6}"
   }
  },
  {
   "name": "handler failure becomes 500 without details",
   "method": "POST",
   "target": "/sum",
   "body": "not json",
   "expect": {
    "status": 500,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"error\":\"internal error\"}"
   }
  },
  {
   "name": "runtime error (division by zero) is 500",
   "method": "GET",
   "target": "/boom",
   "expect": {
    "status": 500,
    "body": "{\"error\":\"internal error\"}"
   }
  },
  {
   "name": "server survives a failing handler",
   "method": "GET",
   "target": "/health",
   "expect": {
    "status": 200,
    "body": "{\"status\":\"ok\"}"
   }
  },
  {
   "name": "204 has no body and keeps headers",
   "method": "DELETE",
   "target": "/things/7",
   "expect": {
    "status": 204,
    "headers": {
     "x-removed": "7",
     "content-type": null
    },
    "body": ""
   }
  },
  {
   "name": "request headers are case-insensitive",
   "method": "GET",
   "target": "/headers",
   "headers": {
    "X-TOKEN": "abc"
   },
   "expect": {
    "status": 200,
    "headers": {
     "x-echo": "abc",
     "x-has-missing": "false",
     "x-method": "GET"
    },
    "body": "/headers"
   }
  },
  {
   "name": "same handler on a second method",
   "method": "PUT",
   "target": "/headers",
   "expect": {
    "status": 200,
    "headers": {
     "x-method": "PUT",
     "x-echo": ""
    },
    "body": "/headers"
   }
  },
  {
   "name": "literal route beats wildcard",
   "method": "GET",
   "target": "/files/readme",
   "expect": {
    "status": 200,
    "body": "literal wins"
   }
  },
  {
   "name": "wildcard captures the remainder",
   "method": "GET",
   "target": "/files/a/b/c",
   "expect": {
    "status": 200,
    "body": "a/b/c"
   }
  },
  {
   "name": "wildcard may capture an empty tail",
   "method": "GET",
   "target": "/files/",
   "expect": {
    "status": 200,
    "body": ""
   }
  },
  {
   "name": "wildcard needs its prefix segment",
   "method": "GET",
   "target": "/files",
   "expect": {
    "status": 404,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"error\":\"not found\"}"
   }
  },
  {
   "name": "unknown path is 404",
   "method": "GET",
   "target": "/nope",
   "expect": {
    "status": 404,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"error\":\"not found\"}"
   }
  },
  {
   "name": "trailing slash is a different path",
   "method": "GET",
   "target": "/health/",
   "expect": {
    "status": 404,
    "body": "{\"error\":\"not found\"}"
   }
  },
  {
   "name": "wrong method is 405 with Allow",
   "method": "POST",
   "target": "/health",
   "expect": {
    "status": 405,
    "headers": {
     "allow": "GET, HEAD",
     "content-type": "application/json"
    },
    "body": "{\"error\":\"method not allowed\"}"
   }
  },
  {
   "name": "OPTIONS is not implicit",
   "method": "OPTIONS",
   "target": "/health",
   "expect": {
    "status": 405,
    "headers": {
     "allow": "GET, HEAD"
    }
   }
  },
  {
   "name": "HEAD falls back to GET without a body",
   "method": "HEAD",
   "target": "/health",
   "expect": {
    "status": 200,
    "headers": {
     "content-type": "application/json",
     "content-length": "15"
    },
    "body": ""
   }
  },
  {
   "name": "state: first increment",
   "method": "GET",
   "target": "/count",
   "expect": {
    "status": 200,
    "body": "1"
   }
  },
  {
   "name": "state: second increment",
   "method": "GET",
   "target": "/count",
   "expect": {
    "status": 200,
    "body": "2"
   }
  },
  {
   "name": "state: third increment",
   "method": "GET",
   "target": "/count",
   "expect": {
    "status": 200,
    "body": "3"
   }
  },
  {
   "name": "state: set",
   "method": "PUT",
   "target": "/note",
   "body": "remember me",
   "expect": {
    "status": 202,
    "body": ""
   }
  },
  {
   "name": "state: get",
   "method": "GET",
   "target": "/note",
   "expect": {
    "status": 200,
    "body": "remember me"
   }
  },
  {
   "name": "responses are Content-Length framed and never say Connection",
   "method": "GET",
   "target": "/health",
   "expect": {
    "status": 200,
    "headers": {
     "connection": null
    }
   }
  },
  {
   "name": "rest_stop() from a handler",
   "method": "POST",
   "target": "/shutdown",
   "stops_server": true,
   "expect": {
    "status": 202,
    "body": "bye"
   }
  },
  {
   "name": "requests after rest_stop() are never answered",
   "method": "GET",
   "target": "/health",
   "unanswered": true,
   "expect": {
    "status": 0
   }
  }
 ],
 "fatal": [
  {
   "name": "malformed request line is 400",
   "method": "GET",
   "target": "/",
   "raw": "garbage\r\n\r\n",
   "expect": {
    "status": 400,
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "chunked request bodies are 501",
   "method": "POST",
   "target": "/sum",
   "raw": "POST /sum HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
   "expect": {
    "status": 501,
    "headers": {
     "content-type": "application/json"
    }
   }
  },
  {
   "name": "body over the limit is 413",
   "method": "POST",
   "target": "/sum",
   "body_repeat": {
    "text": "x",
    "count": 2048
   },
   "expect": {
    "status": 413,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"error\":\"payload too large\"}"
   }
  },
  {
   "name": "oversized header section is 431",
   "method": "GET",
   "target": "/health",
   "headers": {
    "X-Big": ""
   },
   "expect": {
    "status": 431,
    "headers": {
     "content-type": "application/json"
    }
   }
  }
 ],
 "silent": [
  {
   "name": "empty input ends serving cleanly",
   "raw": ""
  },
  {
   "name": "a request truncated by EOF is dropped without a response",
   "raw": "GET /hea"
  },
  {
   "name": "a body truncated by EOF is dropped without a response",
   "raw": "POST /sum HTTP/1.1\r\nContent-Length: 10\r\n\r\n{\"v"
  }
 ]
}
